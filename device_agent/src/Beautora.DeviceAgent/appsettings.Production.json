{
  "DeviceAgent": {
    "MockMode": false,
    "EnableTray": false,
    "LeanMode": true,
    "DiscoveryIntervalMinutes": 15,
    "DisableSecurity": true,
    "Zkteco": {
      "Enabled": true,
      "ProtocolMode": "push-buffer",
      "EnableTcpWatcher": false
    },
    "Beautora": {
      "AppUrl": "https://www.beautora.app",
      "AttendanceSyncEnabled": true,
      "AttendanceSyncIntervalSeconds": 30
    }
  },
  "SyncOpsCloud": {
    "BaseUrl": "https://www.beautora.app"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Beautora.DeviceAgent": "Information",
      "Beautora.DeviceAgent.Api.ZktecoAdms": "Information"
    }
  }
}
