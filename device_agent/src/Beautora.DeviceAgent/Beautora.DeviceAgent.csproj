<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Beautora.DeviceAgent</RootNamespace>
    <AssemblyName>Beautora.DeviceAgent</AssemblyName>
    <Version>1.0.0</Version>
    <Description>SyncOps Device Agent — local Windows hardware bridge (Beautora-compatible)</Description>
    <Authors>SyncOps</Authors>
    <Product>SyncOps Device Agent</Product>
    <!-- Workstation GC = lower RAM for always-on Windows Service -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep Hosting.* on 8.x to match TFM; 10.x EventLog needs AccessControl 10 which single-file publish drops. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="System.Threading.AccessControl" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncOps.DeviceSDK\SyncOps.DeviceSDK.csproj" />
    <ProjectReference Include="..\SyncOps.DeviceAdapters\Printers\SyncOps.DeviceAdapters.Printers.csproj" />
    <ProjectReference Include="..\SyncOps.DeviceAdapters\CashDrawers\SyncOps.DeviceAdapters.CashDrawers.csproj" />
    <ProjectReference Include="..\SyncOps.DeviceAdapters\Fingerprint\SyncOps.DeviceAdapters.Fingerprint.csproj" />
    <ProjectReference Include="..\SyncOps.DeviceAdapters\ZKTeco\SyncOps.DeviceAdapters.ZKTeco.csproj" />
  </ItemGroup>

</Project>
