# =============================================================================
# Beautora env files (Next.js)
# =============================================================================
#
# LOCAL (next dev)
#   .env.development          → non-secret defaults (committed)
#   .env.development.local    → secrets (gitignored)  ← use this for day-to-day
#   Template: .env.development.example
#
# PRODUCTION (next build / next start / Vercel)
#   .env.production           → non-secret defaults (committed)
#   .env.production.local     → secrets (gitignored) OR set in Vercel dashboard
#   Template: .env.production.example
#
# Do NOT put secrets in .env.development / .env.production (they may be committed).
# Prefer NOT using a shared .env.local anymore — it overrides BOTH modes.
#
# Setup:
#   cp .env.development.example .env.development.local
#   cp .env.production.example .env.production.local
#   Fill secrets in each *.local file.
#
# This file is a pointer only. See the mode-specific examples above.
