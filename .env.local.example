# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use either name (publishable is Supabase's newer label for the anon/public key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Database connection — add ONE of these (required for npm run db:setup / db:push):
# Prefer the Pooler URI (IPv4). Direct db.<ref>.supabase.co often fails on Windows (ENOTFOUND / IPv6-only).
# Dashboard → Connect → Connection string → Pooler (Transaction or Session):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Option 2: database password only (+ region if not Singapore):
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_REGION=ap-southeast-1

# Public site URL for SEO (canonical, Open Graph, sitemap). Required in production.
# Use the Beautora product domain; SyncOps studio is linked via JSON-LD + /syncops.
# NEXT_PUBLIC_SITE_URL=https://beautora.app

# --- Email (Resend) ---
# Local: APP_BASE_URL=http://localhost:3000
# Production host secrets (REQUIRED for live verify/reset links):
# APP_BASE_URL=https://beautora.app
# NEXT_PUBLIC_SITE_URL=https://beautora.app
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxxxxxxx
# SMTP_FROM_EMAIL=no-reply@beautora.app
# SMTP_FROM_NAME=Beautora
# Optional alias: RESEND_API_KEY=re_xxxxxxxx
#
# Production checklist:
# 1) Resend → Domains → verify beautora.app (SPF/DKIM) for From: no-reply@beautora.app
# 2) Supabase Auth → Site URL https://beautora.app + Redirect https://beautora.app/auth/callback
# 3) Set SMTP_* + APP_BASE_URL on the production host (never commit real keys)

# Platform admins who approve JazzCash store renewals (comma-separated emails)
# Hardcoded SyncOps admin email is always allowed (see lib/platform/admin.ts — not shown in UI)
# BEAUTORA_PLATFORM_ADMIN_EMAILS=you@beautora.app,admin@syncops.tech

# NEXT_PUBLIC_BOOKING_SLUG=hair-salon

# Thermal receipt paper width: 80mm (default) or 58mm
# NEXT_PUBLIC_RECEIPT_WIDTH=80mm

# Demo login (also hardcoded on /login for retest):
#   owner@salon.com / Salon123!
# Reset business data + reseed: npm run db:reset-test

# WhatsApp Business API (optional — not required for linked-device sending)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_DEFAULT_ORG_ID=your-organization-uuid

# Payment proofs, store logos/covers, and billing invoices use Cloudflare R2.
# Bucket example: salon-storage
# Folder layout inside the bucket:
#   saas_salon/{orgId}/branding/…
#   saas_salon/{orgId}/deposits/…
#   saas_salon/{orgId}/invoices/…
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=salon-storage

# Cash drawer / printer + fingerprint agent (run on the POS PC, not in Next.js):
# Copy scripts/device-agent.env.example → scripts/device-agent.env
# Then: npm run device:agent
# Drawer cable → thermal printer kick/DK port.
# Fingerprint: register Attendance terminal, enroll thumb IDs under Attendance,
# then use /kiosk/attendance?key=… (USB keyboard scanners) or ATTENDANCE_LISTEN_PORT bridge.

