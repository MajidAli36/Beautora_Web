# =============================================================================
# PRODUCTION — copy to .env.production.local OR set these in Vercel/host secrets
#   cp .env.production.example .env.production.local
# Loaded by: next build / next start / Vercel Production
# =============================================================================

# Supabase (production project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=

# Database (only needed for server-side scripts against prod — careful)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_REGION=ap-southeast-1

# Public URLs — PRODUCTION (required for SEO + email links)
NEXT_PUBLIC_SITE_URL=https://www.beautora.app
APP_BASE_URL=https://www.beautora.app

# Resend email (verify domain beautora.app in Resend dashboard)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxx
SMTP_FROM_EMAIL=no-reply@beautora.app
SMTP_FROM_NAME=Beautora

# Platform
BEAUTORA_PLATFORM_ADMIN_EMAILS=admin@syncops.tech
NEXT_PUBLIC_BOOKING_SLUG=hair-salon

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=salon-storage

# Supabase Auth checklist (dashboard, not env):
#   Site URL = https://www.beautora.app
#   Redirect URLs include https://www.beautora.app/auth/callback
#   Also allow https://beautora.app/auth/callback if apex redirects to www
