# =============================================================================
# PRODUCTION — placeholders only. Never put real secrets in git.
#
# Vercel:
#   Set the same keys in the Vercel project → Settings → Environment Variables
#
# Contabo (Docker Compose):
#   cp .env.production.example .env.production.local
#   Fill secrets in .env.production.local on the server (/var/www/beautora)
#   docker compose --env-file .env.production.local up -d --build
#   Never commit .env.production.local
#
# Loaded by: next build / next start / Vercel Production / Contabo container
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer publishable key (new) or anon key (legacy) — app accepts either.
# At least ONE of these two must be set for Docker build + browser/server auth.
# If you only use publishable, leave ANON unset (do not set ANON to empty).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose as NEXT_PUBLIC_* / never pass as Docker build-arg
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (only for ops scripts against prod — careful; not required by the web app)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_REGION=ap-southeast-1

# -----------------------------------------------------------------------------
# Public URLs (required for SEO + email + auth redirects)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.beautora.app
APP_BASE_URL=https://www.beautora.app
EMAIL_APP_BASE_URL=https://www.beautora.app

# -----------------------------------------------------------------------------
# SEO / Analytics (optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Email — Resend (required for auth / transactional mail)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxx
SMTP_FROM_EMAIL=no-reply@beautora.app
SMTP_FROM_NAME=Beautora
# SMTP_REPLY_TO=

# -----------------------------------------------------------------------------
# Platform / booking
# -----------------------------------------------------------------------------
BEAUTORA_PLATFORM_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_BOOKING_SLUG=hair-salon

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (signup CAPTCHA) — required on live site
# https://dash.cloudflare.com/?to=/:account/turnstile
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Cloudflare R2 (uploads / product images)
# R2_ENDPOINT is also used at Docker build time for next/image remotePatterns
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=salon-storage

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_HELP_MODEL=gpt-4o-mini
# NEXT_PUBLIC_RECEIPT_WIDTH=80mm
# Signs customer-app loyalty QR redeem tokens (falls back to service role if unset)
# LOYALTY_QR_SECRET=

# -----------------------------------------------------------------------------
# Build-time vs runtime (Contabo Docker)
# -----------------------------------------------------------------------------
# BUILD-TIME (must be present when `docker compose build` runs — passed as
# build args from this file via --env-file):
#   NEXT_PUBLIC_* , R2_ENDPOINT , APP_BASE_URL , EMAIL_APP_BASE_URL
#
# RUNTIME (read by the container from env_file; never baked into the image):
#   SUPABASE_SERVICE_ROLE_KEY , SMTP_* , R2_ACCESS_KEY_ID , R2_SECRET_ACCESS_KEY ,
#   R2_BUCKET , TURNSTILE_SECRET_KEY , BEAUTORA_PLATFORM_ADMIN_EMAILS , OPENAI_*
#
# After changing any NEXT_PUBLIC_* value, rebuild the image (compose build).

# -----------------------------------------------------------------------------
# Supabase Auth checklist (dashboard, not env):
#   Site URL = https://www.beautora.app
#   Redirect URLs include https://www.beautora.app/auth/callback
#   Also allow https://beautora.app/auth/callback if apex redirects to www
# -----------------------------------------------------------------------------
